{
  "info": {
    "_postman_id": "ipl-ticket-booking-v2",
    "name": "IPL Ticket Booking System - API Gateway (8090)",
    "description": "Complete End-to-End Postman Collection for testing all microservices through the API Gateway (Port 8090).\nFeatures:\n- BCCI Admin & Fan Authentication\n- Franchise User Registration & Login\n- Stadium & Franchise Creation\n- Match Scheduling, Stadium Configuration & BCCI Approval\n- Two-Phase Ticket Hold (10-minute hold with Pessimistic Locking)\n- Razorpay Payment Gateway integration\n- Redis TTL Token Blacklist & Session Management\n- Kafka Event Streaming",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "franchiseToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "stadiumId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "homeFranchiseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "awayFranchiseId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "matchId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "razorpayOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Auth Service)",
      "item": [
        {
          "name": "1.1 Login as BCCI Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    console.log('Admin Token stored successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bcci.official@gmail.com\",\n  \"password\": \"bcc@virat@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as the auto-seeded BCCI SuperAdmin. Automatically captures the accessToken into {{adminToken}} and refreshToken into {{refreshToken}}."
          }
        },
        {
          "name": "1.2 Register Franchise Account (BCCI Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"csk_admin\",\n  \"email\": \"admin@csk.com\",\n  \"password\": \"Csk@2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/franchise/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "franchise", "register"]
            },
            "description": "BCCI Admin registers an official franchise user login with ROLE_FRANCHISE. Returns the generated userId."
          }
        },
        {
          "name": "1.3 Login as Franchise User (RCB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('franchiseToken', jsonData.data.accessToken);",
                  "    console.log('Franchise Token stored successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rcb.com\",\n  \"password\": \"Rcb@2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as the RCB Franchise User. Captures the accessToken into {{franchiseToken}}."
          }
        },
        {
          "name": "1.4 Register Fan User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"virat_fan\",\n  \"email\": \"fan@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Public registration endpoint for fans. Always assigns the USER role."
          }
        },
        {
          "name": "1.5 Login as Fan User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('userToken', jsonData.data.accessToken);",
                  "    console.log('User Token stored successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fan@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as a fan user. Automatically sets {{userToken}}."
          }
        },
        {
          "name": "1.6 Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Fetches profile info of the authenticated user."
          }
        },
        {
          "name": "1.7 Refresh Token (Redis TTL Token Session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchanges a valid refresh token for a fresh access token. Backed by Redis TTL."
          }
        },
        {
          "name": "1.8 Logout (Revoke Tokens with Redis Blocklist)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logs out user, blacklisting access token in Redis and revoking the refresh token session."
          }
        },
        {
          "name": "1.9 Get RSA Public Key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/public-key",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "public-key"]
            },
            "description": "Public endpoint to retrieve the RS256 Public Key."
          }
        }
      ]
    },
    {
      "name": "2. Event Management (Event Service)",
      "item": [
        {
          "name": "2.1 Register Stadium (BCCI Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('stadiumId', jsonData.data.id);",
                  "    console.log('Stadium ID stored:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Eden Gardens\",\n  \"city\": \"Kolkata\",\n  \"state\": \"West Bengal\",\n  \"country\": \"India\",\n  \"address\": \"B.B.D. Bagh, Kolkata\",\n  \"capacity\": 68000,\n  \"description\": \"One of the most iconic cricket grounds in India\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1540747913346-19e32dc3e97e\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/stadiums",
              "host": ["{{baseUrl}}"],
              "path": ["events", "stadiums"]
            },
            "description": "BCCI registers an official IPL stadium venue. Automatically populates all metadata and baseline ticket category tiers."
          }
        },
        {
          "name": "2.2 List All Stadiums",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/stadiums",
              "host": ["{{baseUrl}}"],
              "path": ["events", "stadiums"]
            },
            "description": "Publicly lists all registered stadiums with capacities, cities, and status."
          }
        },
        {
          "name": "2.3 Register Franchise Team (BCCI Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('homeFranchiseId', jsonData.data.id);",
                  "    console.log('Franchise ID stored:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"franchiseName\": \"Kolkata Knight Riders\",\n  \"teamCode\": \"KKR\",\n  \"shortName\": \"KKR\",\n  \"city\": \"Kolkata\",\n  \"description\": \"Official IPL franchise representing Kolkata\",\n  \"logoUrl\": \"https://images.unsplash.com/photo-1540747913346-19e32dc3e97e\",\n  \"contactEmail\": \"contact@kkr.in\",\n  \"contactPhone\": \"+91 98765 43210\",\n  \"homeStadiumId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/franchises",
              "host": ["{{baseUrl}}"],
              "path": ["events", "franchises"]
            },
            "description": "BCCI registers a new franchise team and links it to a stadium and franchise user account."
          }
        },
        {
          "name": "2.4 List All Franchises",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/franchises",
              "host": ["{{baseUrl}}"],
              "path": ["events", "franchises"]
            },
            "description": "Publicly lists all active IPL franchise teams."
          }
        },
        {
          "name": "2.5 Schedule Match (BCCI Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.matchId) {",
                  "    pm.collectionVariables.set('matchId', jsonData.data.matchId);",
                  "    console.log('Match ID stored:', jsonData.data.matchId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeFranchiseId\": 1,\n  \"awayFranchiseId\": 2,\n  \"matchDateTime\": \"2027-04-10T19:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/matches",
              "host": ["{{baseUrl}}"],
              "path": ["events", "matches"]
            },
            "description": "BCCI schedules a fixture between Home and Away franchises. Status: CONFIGURATION_PENDING."
          }
        },
        {
          "name": "2.6 Configure Stadium & Categories (Home Franchise or BCCI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stadiumId\": 1,\n  \"categories\": [\n    {\n      \"categoryName\": \"VIP Lounge\",\n      \"capacity\": 500,\n      \"price\": 15000.00\n    },\n    {\n      \"categoryName\": \"Premium Pavilion\",\n      \"capacity\": 2500,\n      \"price\": 5000.00\n    },\n    {\n      \"categoryName\": \"General Stand\",\n      \"capacity\": 25000,\n      \"price\": 1500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/matches/{{matchId}}/configuration",
              "host": ["{{baseUrl}}"],
              "path": ["events", "matches", "{{matchId}}", "configuration"]
            },
            "description": "Configures stadium allocation and ticket tier pricing. Status becomes WAITING_FOR_APPROVAL."
          }
        },
        {
          "name": "2.7 Approve Match (BCCI Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/matches/{{matchId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["events", "matches", "{{matchId}}", "approve"]
            },
            "description": "BCCI approves match configuration. Calculates ticketOpenAt (matchDateTime - 5 days), sets status to APPROVED, and emits Kafka event."
          }
        },
        {
          "name": "2.8 List Matches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/matches",
              "host": ["{{baseUrl}}"],
              "path": ["events", "matches"]
            },
            "description": "Lists all scheduled IPL matches."
          }
        },
        {
          "name": "2.9 Get Match Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/matches/{{matchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "matches", "{{matchId}}"]
            },
            "description": "Fetches details of a specific match by ID."
          }
        }
      ]
    },
    {
      "name": "3. Ticket Booking & Orders (Order Service)",
      "item": [
        {
          "name": "3.1 Check Live Ticket Inventory for Match",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/inventory/{{matchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "inventory", "{{matchId}}"]
            },
            "description": "Queries live ticket inventory in order_db. Shows availableQuantity vs totalQuantity."
          }
        },
        {
          "name": "3.2 Reserve Tickets (10-Min Hold with Pessimistic Lock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('orderId', jsonData.data.id);",
                  "    console.log('Order ID stored:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchId\": {{matchId}},\n  \"items\": [\n    {\n      \"ticketCategoryId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "reserve"]
            },
            "description": "Phase 1: Decrements available tickets in order_db using SELECT ... FOR UPDATE and holds reservation for 10 minutes."
          }
        },
        {
          "name": "3.3 Initiate Razorpay Order (Phase 2a)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.razorpayOrderId) {",
                  "    pm.collectionVariables.set('razorpayOrderId', jsonData.data.razorpayOrderId);",
                  "    console.log('Razorpay Order ID stored:', jsonData.data.razorpayOrderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/razorpay/create",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "razorpay", "create"]
            },
            "description": "Generates a Razorpay Order ID for payment processing with amount in paise."
          }
        },
        {
          "name": "3.4 Confirm Payment via Razorpay (Phase 2b)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"RAZORPAY\",\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"pay_test_998877665544\",\n  \"razorpaySignature\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "pay"]
            },
            "description": "Finalizes the booking via Razorpay payment confirmation. Publishes ipl.order.confirmed event to Kafka."
          }
        },
        {
          "name": "3.5 Confirm Payment via Standard UPI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"UPI\",\n  \"paymentReference\": \"UPI_REF_987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "pay"]
            },
            "description": "Alternative payment confirmation using direct UPI/NetBanking reference."
          }
        },
        {
          "name": "3.6 Get Order Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Fetches order status, ticket items, total price, and expiration timestamp."
          }
        },
        {
          "name": "3.7 View My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            },
            "description": "Lists all orders booked by the authenticated fan."
          }
        },
        {
          "name": "3.8 Cancel Reservation (Releases Held Tickets)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            },
            "description": "Cancels a PENDING reservation and immediately returns held tickets back to available inventory with pessimistic row locking. Publishes ipl.ticket.released event to Kafka."
          }
        }
      ]
    }
  ]
}
